# Build output
build/
out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.a
*.lib
*.exe
*.pdb

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Unreal Engine
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
*.sln
*.VC.db
*.opensdf
*.sdf
*.suo

# Junctions created by scripts/link_ue.ps1
UnrealHost/Plugins/
ue5-plugin/SwarmSim/Source/SwarmSim/Private/swarm_format

# Editors
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Run output. Commit only small golden files under tests/golden/.
logs/
runs/
*.log
*.rec
results/
!tests/golden/**

# Local
.env

# Licensed asset packs installed into the Unreal host project. They are not redistributable, so
# nothing under Content is committed except the placeholder.
UnrealHost/Content/*
!UnrealHost/Content/.gitkeep
# Editor-generated project settings for the host. They hold a per-machine token, so they are not
# committed; settings the viewer needs are set in code.
UnrealHost/Config/
